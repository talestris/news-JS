{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "module": "esnext",
        "target": "es2022",
        "moduleResolution": "node10",
        "lib": ["es2022", "DOM"],

        "sourceMap": true,

        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}
